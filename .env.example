# Copy these to Railway → your service → Variables. None are needed to run locally.

# PostgreSQL. On Railway, reference the Postgres service: ${{Postgres.DATABASE_URL}}
DATABASE_URL=

# The first manager account, created on first start when there are no users yet.
# (In production, browser-based first-run setup is disabled unless ALLOW_SETUP=1.)
MANAGER_EMAIL=you@scalemedia.com
MANAGER_NAME=Your Name
MANAGER_PASSWORD=choose-a-long-password

# Optional
# UPLOAD_LIMIT_MB=25               # largest briefing file people can upload
# REMINDER_INTERVAL_MINUTES=10     # how often the in-process reminder scheduler runs
# REMINDERS=off                    # turn the in-process scheduler off (e.g. if you use a cron service instead)
# PGSSL=1                          # force TLS to Postgres if your provider needs it
# DATA_DIR=data/pglite             # embedded database directory when DATABASE_URL is not set
