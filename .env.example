# Set these in Render → your web service → Environment (render.yaml wires DATABASE_URL for you).
# None are needed to run locally. Every variable the server reads is parsed in server/config.ts;
# a value that doesn't parse is reported in the log and the default is used. On/off settings take 1/0, true/false, yes/no or on/off.

# PostgreSQL connection string (Render: the database's internal connection string)
DATABASE_URL=

# The first manager account, created on first start when there are no users yet.
# (In production, browser-based first-run setup is disabled unless ALLOW_SETUP=1.)
# Fill these in yourself (e.g. you@scalemedia.com, Your Name, and a password of at least
# 10 characters): left as they are, nothing is created and the sign-in page says what to set.
MANAGER_EMAIL=
MANAGER_NAME=
MANAGER_PASSWORD=
# Locked out? Set to 1, deploy, sign in, then remove it: resets MANAGER_EMAIL's password to MANAGER_PASSWORD.
# MANAGER_RESET_PASSWORD=1

# Optional
# ANTHROPIC_API_KEY=               # turns on New work → Paste notes (Claude reads pasted notes)
# TIMELINER_API_KEY=               # Timeliner → Settings → Developers (tlsk_…, with Webhooks read & write, Projects read, Workspace read): a script document uploaded in Timeliner marks its batch delivered
# PUBLIC_URL=                      # the site's https address, for the webhook Timeliner calls (Render sets RENDER_EXTERNAL_URL, which is used when this is empty)
# TIMELINER_API_URL=https://timeliner.io   # rarely: where Timeliner's API lives
# UPLOAD_LIMIT_MB=25               # largest file people can upload (1–100)
# REMINDER_INTERVAL_MINUTES=10     # how often the in-process reminder scheduler runs (1–1440)
# CALENDAR_SYNC=on                 # re-read synced calendars (Google Calendar iCal links) on a timer; off to stop
# CALENDAR_SYNC_MINUTES=15         # how often (1–1440)
# CALENDAR_ALLOW_PRIVATE=1         # let a calendar link point at a private network address (off by default: protects the server's network)
# REMINDERS=off                    # turn the in-process scheduler off (e.g. if you use a cron service instead)
# PGSSL=1                          # force TLS to Postgres if your provider needs it
# ALLOW_SETUP=1                    # allow first-run setup from the browser in production
# DATA_DIR=data/pglite             # embedded database directory when DATABASE_URL is not set
# PORT=3001                        # set by the host (Render/Railway) in production
# HOST=0.0.0.0
# TRUST_PROXY=1                    # proxy hops to believe for the client's address (default: all, which clients can forge); use the smallest number for which your Master log address matches what a "what is my IP" site shows (higher lets clients forge it again)

# Set by the host or the scripts, rarely by hand
# NODE_ENV=production              # (or RENDER / RAILWAY_ENVIRONMENT, set by those hosts) production mode: secure cookies, needs DATABASE_URL or DATA_DIR
# DEMO=1                           # `npm run demo`: seed the sample workspace (in data/demo)
# STATIC_DIR=                      # where the built client is served from; empty serves none (the dev runner, where Vite serves it)
# API_PORT=3001                    # dev only: the port Vite proxies /api to
# TEST_DATABASE_URL=               # tests only: run them on a real PostgreSQL (its schema is wiped first)
